{
  "name": "ai-generate-rewrite",
  "method": "POST",
  "path": "/ai-generate-rewrite",
  "description": "Rewrite the words the writer selected as the writer asked",
  "request": {
    "type": "object",
    "properties": {
      "userTask": {
        "type": "string",
        "minLength": 1
      },
      "userName": {
        "type": "string",
        "minLength": 1
      },
      "taskId": {
        "type": "string",
        "minLength": 1
      },
      "selectedContent": {
        "type": "string",
        "minLength": 1
      },
      "userPrompt": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": true,
    "required": [
      "userTask",
      "userName",
      "taskId",
      "selectedContent",
      "userPrompt"
    ]
  },
  "response": {
    "type": "object",
    "properties": {
      "rewrittenContent": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": true,
    "required": [
      "rewrittenContent"
    ]
  }
}
