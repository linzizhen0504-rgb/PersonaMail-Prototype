{
  "name": "preference-update",
  "method": "POST",
  "path": "/preference/update",
  "description": "Tell the preference model how a display of versions ended (pick, regenerate, leave), or that the user used AI-written text instead of a card (ai_edit)",
  "request": {
    "type": "object",
    "properties": {
      "pid": {
        "type": "string",
        "minLength": 1
      },
      "context": {
        "type": "string",
        "minLength": 1
      },
      "intent_dimension": {
        "type": "string",
        "minLength": 1
      },
      "event": {
        "type": "string",
        "minLength": 1
      },
      "chosen_value": {
        "type": [
          "string",
          "null"
        ]
      },
      "shown_values": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "session_id": {
        "type": "string"
      },
      "current_text": {
        "type": "string"
      },
      "shown_texts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "prompt": {
        "type": "string",
        "description": "ai_edit: what the user asked the AI to do"
      },
      "new_text": {
        "type": "string",
        "description": "ai_edit: the text the user used (current_text is the text before)"
      },
      "candidates": {
        "type": "array",
        "description": "ai_edit: the values the part can move to, which the prompt is matched with",
        "items": {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "dimension",
            "value"
          ]
        }
      }
    },
    "additionalProperties": true,
    "required": [
      "pid",
      "context",
      "intent_dimension",
      "event"
    ]
  },
  "response": {
    "type": "object",
    "properties": {},
    "additionalProperties": true
  }
}
